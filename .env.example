# Copia este archivo a .env SOLO para desarrollo local. En producción usa un gestor de secretos (ver DESPLIEGUE.md).
# Nunca subas .env al repositorio.

# ---- IA gratuita (OPCIONAL). Sin estas variables NO se hace ninguna llamada de red y no hay costo. ----
# No se usa la API de Claude. Necesitas tu propia clave gratuita. No añadas método de pago en el proveedor.
# PQRS_IA_PROVIDER=groq            # groq | openrouter | custom
# PQRS_IA_KEY=
# PQRS_IA_MODEL=                   # un modelo GRATUITO vigente; con openrouter debe terminar en :free
# PQRS_IA_URL=                     # solo para custom (debe ser https://)
# PQRS_IA_MAX_MIN=10               # tope local de llamadas por minuto
# PQRS_IA_MAX_DIA=40               # tope local de llamadas por día

# ---- Envío de respuestas por correo (OPCIONAL). Sin esto, el botón "Enviar por correo" queda desactivado. ----
# Siempre usa STARTTLS (puerto 587). Con Gmail: smtp.gmail.com y una "contraseña de aplicación", no tu contraseña normal.
# PQRS_SMTP_HOST=smtp.gmail.com
# PQRS_SMTP_PORT=587
# PQRS_SMTP_USER=
# Contraseña: usa UNA de las dos. Se prefiere el archivo (no queda en el entorno del proceso):
# PQRS_SMTP_PASSWORD_FILE=/ruta/secreta/smtp_clave   # archivo con solo la contraseña, permisos de lectura solo para el servicio
# PQRS_SMTP_PASSWORD=
# PQRS_SMTP_FROM=Atención al cliente <tu-correo@ejemplo.com>
# PQRS_URL_PUBLICA=https://pqrs.tuempresa.com        # obligatoria y con HTTPS para enviar el correo de verificación
# PQRS_VERIF_MAX_DIA=200                              # tope diario de correos de verificación
# PQRS_MAIL_LIMIT=10               # máximo de correos por minuto por funcionario
# PQRS_PLAZO_DIAS=15               # días hábiles de plazo por solicitud (confirma el plazo legal que te aplica)

# ---- Anti-bots del formulario público (/solicitar) ----
# PQRS_SECRETO=                    # una cadena larga y aleatoria; OBLIGATORIA si ejecuta varios procesos (para que compartan los retos)
# PQRS_ANTIBOT_BITS=16             # dificultad del cálculo (16 ≈ 1-3 s; 18 ≈ 4× más)
# PQRS_ANTIBOT_MIN_SEG=2           # segundos mínimos que debe tardar una persona en resolver el reto
# PQRS_RETO_LIMIT=30               # retos por minuto por IP

# ---- Aviso de privacidad (OBLIGATORIO para abrir el formulario público; sin esto /solicitar queda cerrado) ----
# PQRS_EMPRESA=Razón social y NIT
# PQRS_CONTACTO_DATOS=datos@tuempresa.com
# PQRS_RETENCION=2 años desde que resolvemos su solicitud
# PQRS_PROVEEDOR_CORREO=Nombre de tu proveedor de correo      # obligatorio si envías correos
# PQRS_DIRECCION=                                              # opcional
# PQRS_PERMITIR_AVISO_INCOMPLETO=1                             # SOLO para pruebas locales; nunca en producción
# PQRS_PUBLICO_MAX_HORA=300                                    # tope TOTAL de solicitudes públicas por hora (defensa contra abuso distribuido)

# ---- Operación: respaldos y monitoreo (ver DESPLIEGUE.md, secciones 5 y 6) ----
# PQRS_RESPALDO_DIR=D:\respaldos                     # carpeta de respaldos: preflight y monitoreo comprueban que haya copias recientes
# PQRS_ALERTA_RESPALDO_HORAS=36
# PQRS_ALERTA_LOGINS_FALLIDOS_1H=20
# PQRS_ALERTA_BLOQUEOS_1H=3
# PQRS_ALERTA_ENVIOS_FALLIDOS_24H=3
# PQRS_ALERTA_POR_VENCER=5
# PQRS_ALERTA_NUEVAS_SIN_ATENDER_HORAS=48
# PQRS_SALUD_LIMIT=60                                # consultas por minuto a GET /salud
# PQRS_HUMO_USUARIO= / PQRS_HUMO_CLAVE=              # SOLO para prueba_humo.py: una cuenta de PRUEBA, en el entorno de quien la ejecuta

# ---- Aviso de entrega/rebote del correo (webhook, opcional) ----
# PQRS_WEBHOOK_SECRETO=            # secreto compartido con tu proveedor o traductor (n8n/Make); sin él, el webhook está apagado
# PQRS_WEBHOOK_LIMIT=120

# ---- Solo para pruebas con servidor local (herramientas/servidor_correo_local.py) ----
# PQRS_SMTP_CA_FILE=herramientas/.local/cert.pem   # confía SOLO en este certificado; no desactiva la verificación TLS
# PQRS_SMTP_TIMEOUT=15

# ---- Base de datos. SQLite por defecto; para PostgreSQL: ----
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/pqrs
DATABASE_URL=sqlite:///pqrs.db

# ---- Primer administrador (solo se usa si aún no hay usuarios; bórralo después). Alternativa: python crear_usuario.py ----
# PQRS_ADMIN_USER=
# PQRS_ADMIN_PASSWORD=

# ---- Red y sesiones ----
# PQRS_TRUST_PROXY=1     # solo con UN proxy de confianza delante
# PQRS_HTTPS=1           # activa HSTS cuando el sitio ya use HTTPS
# PQRS_RATE_LIMIT=10
# PQRS_LOGIN_LIMIT=5
# PQRS_SESION_HORAS=8
